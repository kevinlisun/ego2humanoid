diff --git a/scripts/installation/faiss_gpu.sh b/scripts/installation/faiss_gpu.sh
index 0a73272..8d5de3f 100644
--- a/scripts/installation/faiss_gpu.sh
+++ b/scripts/installation/faiss_gpu.sh
@@ -9,7 +9,7 @@ FAISS_GPU_TEMP_MEMORY="${FAISS_GPU_TEMP_MEMORY:-67108864}"
 install_faiss_gpu() {
   local env_name="${1:?env name is required}"
   echo "Installing FAISS GPU ${FAISS_GPU_VERSION} in ${env_name}"
